{
  "meta": {
    "vertical": "developer tooling / self-hostable infrastructure",
    "version": "spike-0.1",
    "notes": "expected_license_class values are PRIORS from memory. adapter.py re-derives them from live LICENSE files; mismatches are reported, not hidden.",
    "license_classes": {
      "permissive": [
        "MIT",
        "BSD",
        "Apache-2.0",
        "ISC"
      ],
      "copyleft": [
        "GPL",
        "AGPL",
        "LGPL",
        "MPL"
      ],
      "source_available": [
        "BUSL",
        "FSL",
        "Polyform",
        "SSPL",
        "Elastic"
      ],
      "custom": [
        "Apache/MIT base + additional terms"
      ],
      "mixed": [
        "multiple licenses by directory or version"
      ]
    },
    "constraint_semantics": {
      "osi_open_source": "permissive or copyleft",
      "permissive": "permissive only",
      "states": "satisfied | violated | unresolved (mixed, custom, unverified)"
    }
  },
