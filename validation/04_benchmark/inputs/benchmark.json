  "scenarios": [
    {
      "id": "S01",
      "domain": "observability",
      "problem": "We're a 4-person team and want error tracking for our Python and JS apps. It must be self-hosted and have a genuinely open-source license.",
      "constraints": {
        "license": "osi_open_source",
        "hosting": "self_hosted",
        "cost": "free"
      },
      "requirements": [
        {
          "name": "capture exceptions from app SDKs",
          "priority": "must_have"
        },
        {
          "name": "stack traces with issue grouping",
          "priority": "must_have"
        },
        {
          "name": "alerting",
          "priority": "must_have"
        },
        {
          "name": "low operational footprint",
          "priority": "nice_to_have"
        }
      ],
      "viable": [
        "glitchtip"
      ],
      "static_non_viable": [],
      "license_traps": [
        "sentry",
        "bugsink"
      ],
      "expected_status": "paths",
      "notes": "Tests whether 'self-hostable' gets confused with 'open source'.",
      "constraint_violators": []
    },
    {
      "id": "S02",
      "domain": "deployment",
      "problem": "I want a Heroku-like git-push deploy experience on a single cheap VPS I control, without running Kubernetes.",
      "constraints": {
        "license": null,
        "hosting": "self_hosted",
        "cost": "free"
      },
      "requirements": [
        {
          "name": "deploy from git or container image",
          "priority": "must_have"
        },
        {
          "name": "runs on a single server",
          "priority": "must_have"
        },
        {
          "name": "automatic TLS/domains",
          "priority": "nice_to_have"
        }
      ],
      "viable": [
        "coolify",
        "dokku",
        "caprover"
      ],
      "static_non_viable": [
        {
          "name": "Kubernetes",
          "reason": "violates 'without Kubernetes'"
        },
        {
          "name": "Heroku",
          "reason": "hosted and paid, violates self-hosted/free"
        }
      ],
      "license_traps": [],
      "expected_status": "paths",
      "constraint_violators": []
    },
